# Habibi ERP — окружение развёртывания
# Полное описание переменных: docs/02-setup/04-env-variables.md
#
# Использование:
#   docker compose --env-file habibi.env -f compose.yaml \
#     -f overrides/compose.mariadb.yaml \
#     -f overrides/compose.redis.yaml \
#     -f overrides/compose.noproxy.yaml up -d

# --- Образ ---------------------------------------------------------------
# compose.yaml подставляет их в:
#   image: ${CUSTOM_IMAGE:-frappe/erpnext}:${CUSTOM_TAG:-$ERPNEXT_VERSION}
CUSTOM_IMAGE=ghcr.io/dhi-partners/habibi-erp
CUSTOM_TAG=16

# always  — тянуть образ из ghcr.io (образ собирает CI)
# missing — использовать локально собранный образ (см. scripts/habibi-build.sh)
PULL_POLICY=always

# Резервный тег, если CUSTOM_TAG не задан. Также фиксирует линию версии.
ERPNEXT_VERSION=v16.30.0

# --- База данных ---------------------------------------------------------
# ⚠️ ОБЯЗАТЕЛЬНО заменить перед любым развёртыванием вне localhost.
DB_PASSWORD=change-me

# Только для внешней БД (оставьте пустым для контейнера mariadb из override)
DB_HOST=
DB_PORT=

# --- Redis ---------------------------------------------------------------
# Только для внешнего Redis (оставьте пустым для контейнеров из override)
REDIS_CACHE=
REDIS_QUEUE=

# --- Gunicorn ------------------------------------------------------------
GUNICORN_THREADS=4
# Типичная формула: (2 x число ядер) + 1
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# --- Маршрутизация -------------------------------------------------------
# Имя сайта должно совпадать с хостом. Для локального доступа по
# http://localhost:8080 создавайте сайт с именем, указанным здесь.
FRAPPE_SITE_NAME_HEADER=habibi.localhost
HTTP_PUBLISH_PORT=8080

UPSTREAM_REAL_IP_ADDRESS=127.0.0.1
UPSTREAM_REAL_IP_HEADER=X-Forwarded-For
UPSTREAM_REAL_IP_RECURSIVE=off

PROXY_READ_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m

# --- Только для HTTPS-оверрайдов ----------------------------------------
LETSENCRYPT_EMAIL=mail@example.com
SITES_RULE=Host(`erp.example.com`)
NGINX_PROXY_HOSTS=erp.example.com
