# Habibi ERP — локальная проверка развёртывания.
#
# Отличается от habibi.env одной строкой: PULL_POLICY=missing, то есть
# образ берётся из локальной сборки (scripts/habibi-build.sh), а не из
# ghcr.io. Всё остальное совпадает с серверным конфигом, поэтому проверка
# повторяет реальный путь развёртывания.
#
# Использование:
#   ./scripts/habibi-build.sh
#   docker compose --env-file habibi-local.env -f compose.yaml \
#     -f overrides/compose.mariadb.yaml \
#     -f overrides/compose.redis.yaml \
#     -f overrides/compose.noproxy.yaml up -d

# --- Образ ---------------------------------------------------------------
CUSTOM_IMAGE=ghcr.io/dhi-partners/habibi-erp
CUSTOM_TAG=16

# missing — использовать локально собранный образ, не тянуть из registry.
# Это единственное отличие от habibi.env.
PULL_POLICY=missing

ERPNEXT_VERSION=v16.30.0

# --- База данных ---------------------------------------------------------
# Локальный тест, наружу не публикуется. Это же значение нужно передать
# в bench new-site как --db-root-password.
DB_PASSWORD=change-me

DB_HOST=
DB_PORT=

# --- Redis ---------------------------------------------------------------
REDIS_CACHE=
REDIS_QUEUE=

# --- Gunicorn ------------------------------------------------------------
GUNICORN_THREADS=4
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# --- Маршрутизация -------------------------------------------------------
# Заголовок задан явно, поэтому сайт открывается по http://localhost:8080
# независимо от Host. Имя сайта в bench new-site должно совпадать с этим.
FRAPPE_SITE_NAME_HEADER=habibi.localhost
HTTP_PUBLISH_PORT=8080

UPSTREAM_REAL_IP_ADDRESS=127.0.0.1
UPSTREAM_REAL_IP_HEADER=X-Forwarded-For
UPSTREAM_REAL_IP_RECURSIVE=off

PROXY_READ_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m

# --- Не используются без HTTPS-оверрайдов --------------------------------
LETSENCRYPT_EMAIL=mail@example.com
SITES_RULE=Host(`erp.example.com`)
NGINX_PROXY_HOSTS=erp.example.com
